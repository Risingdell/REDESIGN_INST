# Copy to .env and fill in. Every value is optional — the site runs without them.

# Base URL of the forms/booking/payment API. When empty, the site runs in demo mode:
# submissions are kept in the visitor's browser and no payment is taken.
VITE_API_BASE_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable tracking.
VITE_GA_MEASUREMENT_ID=

# Public path when the site is hosted in a subfolder (e.g. /new/). Defaults to /.
VITE_BASE=/
